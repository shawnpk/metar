<% content_for :title, "METAR Reader — Decode Airport Weather" %>
<% content_for :description, "Enter an ICAO airport code to get a plain-English breakdown of the latest METAR weather report." %>

<div class="min-h-screen w-full flex flex-col items-center justify-center px-4">
  <div class="max-w-lg w-full">
    <div class="text-center mb-10">
      <h1 class="text-4xl font-bold text-sky-700 mb-2">METAR Reader</h1>
      <p class="text-gray-500 text-lg">Enter an ICAO airport code to get a plain-English weather report</p>
    </div>

    <% if flash[:error] %>
      <div class="mb-6 bg-red-50 border border-red-200 text-red-700 rounded-xl px-5 py-4 text-sm">
        <%= flash[:error] %>
      </div>
    <% end %>

    <%= form_with url: weather_path, method: :get, class: "flex gap-3" do |f| %>
      <%= f.text_field :airport_code,
            placeholder: "e.g. KSLC, KJFK, EGLL",
            autofocus: true,
            class: "flex-1 border border-gray-300 rounded-xl px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-sky-400 uppercase",
            maxlength: 10 %>
      <%= f.submit "Decode",
            class: "bg-sky-600 hover:bg-sky-700 text-white font-semibold px-6 py-3 rounded-xl cursor-pointer transition-colors" %>
    <% end %>

    <% if @recent_airports.any? %>
      <div class="mt-8">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Recent searches</p>
        <div class="flex flex-wrap gap-2">
          <% @recent_airports.each do |code| %>
            <%= link_to code, weather_path(airport_code: code),
                  class: "bg-white border border-gray-200 hover:border-sky-400 hover:text-sky-700 text-gray-700 text-sm font-mono font-semibold px-4 py-2 rounded-xl transition-colors" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <p class="mt-8 text-center text-xs text-gray-400">
      Data provided by <a href="https://aviationweather.gov" target="_blank" class="underline hover:text-gray-600">aviationweather.gov</a>
    </p>
  </div>
</div>
